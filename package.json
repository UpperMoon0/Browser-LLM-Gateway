{
  "name": "browser-llm-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "OpenAI-compatible gateway backed by the ChatGPT web UI through Playwright.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "auth": "tsx scripts/auth.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "fastify": "^5.5.0",
    "playwright": "^1.54.2",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
